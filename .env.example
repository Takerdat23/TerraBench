# TerraBench local runtime configuration.
# Copy to .env and fill only the services/tools you plan to use.

# Main agent LLM provider.
TERRABENCH_MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=

# Web search and web summarization.
SERPER_API_KEY=
WEB_SUMMARY_MODEL_PROVIDER=openai
WEB_SUMMARY_MODEL=
WEB_SUMMARY_PROMPT_PATH=terra_agent/prompts/runtime/web_summary_prompt.yaml
WEB_SUMMARY_OPENAI_API_KEY=
WEB_SUMMARY_ANTHROPIC_API_KEY=

# InterCode-backed code agent. MATH_AGENT_* is still accepted for compatibility.
CODE_AGENT_BASE_URL=http://127.0.0.1:8000
CODE_AGENT_ROUTE=/code-agent
CODE_AGENT_UPLOAD_URL=http://127.0.0.1:8000/code-agent/upload
CODE_AGENT_MODEL=
MATH_AGENT_BASE_URL=http://127.0.0.1:8000
MATH_AGENT_ROUTE=/math-agent
MATH_AGENT_UPLOAD_URL=http://127.0.0.1:8000/math-agent/upload
MATH_AGENT_MODEL=

# Copernicus CDS / C3S / ERA5 tools.
CDS_API_KEY=
CDSAPI_KEY=
CDS_URL=https://cds.climate.copernicus.eu/api

# Google Earth Engine tools.
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=
GEE_VERIFY=true

# Forecast model assets. Keep downloaded weights outside Git.
PANGU_MODEL_PATH=
AURORA_MODEL_REPO=microsoft/aurora

# Simulator backends. Official binaries/data are intentionally external.
CLIMATE_SIMULATOR_BACKEND=official
AQUACROP_HOME=
AQUACROP_COMMAND=
AQUACROP_BACKEND=
DSSAT_COMMAND=
DSSAT_RUN_FOLDER=
DSSAT_METRICS_PATH=
ENERGYPLUS_EXE=
SUMO_BINARY=
BENMAP_COMMAND=
